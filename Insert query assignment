CREATE DATABASE Food;

USE Food;

CREATE TABLE Food_items (
    item_id INT PRIMARY KEY,
    food_name VARCHAR(100) NOT NULL,
    price DECIMAL(10, 2) NOT NULL,
    qty INT NOT NULL,
    total DECIMAL(10, 2) GENERATED ALWAYS AS (price * qty) STORED
);

